# ─── Database (Supabase / Neon / Vercel Postgres) ────────────────────────────
# Use the pooled connection string for DATABASE_URL (Prisma's connection pool)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:6543/postgres?pgbouncer=true"

# Use the direct (non-pooled) connection string for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-here"

# In development
NEXTAUTH_URL="http://localhost:3000"
# In production (set this in Vercel env vars)
# NEXTAUTH_URL="https://safyr.ai"

# ─── OAuth Providers ─────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub → Settings → Developer settings → OAuth Apps
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"

# ─── AI Providers (for running agent workflows) ───────────────────────────────
ANTHROPIC_API_KEY="sk-ant-api03-..."
OPENAI_API_KEY="sk-proj-..."

# ─── Optional: Upstash Redis (rate limiting, job queue) ───────────────────────
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Optional: Resend (transactional email) ────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@safyr.ai"
